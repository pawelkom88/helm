{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .helm/bin/helm_guard.py shell --platform codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .helm/bin/helm_guard.py tool --platform codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
