{
  "version": 1,
  "permissions": {
    "allow": [],
    "deny": [
      "Shell(sudo)", "Shell(su)", "Shell(doas)",
      "Shell(curl)", "Shell(wget)", "Shell(nc)", "Shell(ncat)", "Shell(ssh)", "Shell(scp)", "Shell(sftp)",
      "Shell(gh)", "Shell(glab)",
      "Read(**/.env)", "Read(**/.env.local)", "Read(**/.env.*.local)", "Read(**/.env.production)", "Read(**/.env.development)",
      "Read(**/*.pem)", "Read(**/*.key)", "Read(**/id_rsa*)", "Read(**/id_ed25519*)",
      "Write(**/.env)", "Write(**/.env.*)",
      "Write(.git/**)", "Write(.cursor/**)", "Write(AGENTS.md)",
      "Write(.helm/bin/**)", "Write(.helm/policy/**)", "Write(.helm/templates/**)", "Write(.helm/repo/**)",
      "Write(.helm/skills.lock.json)"
    ]
  }
}
