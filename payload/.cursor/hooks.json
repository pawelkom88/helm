{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "python3 .helm/bin/helm_guard.py session", "timeout": 10 }
    ],
    "beforeShellExecution": [
      { "command": "python3 .helm/bin/helm_guard.py shell", "failClosed": true, "timeout": 15 }
    ],
    "beforeMCPExecution": [
      { "command": "python3 .helm/bin/helm_guard.py mcp", "failClosed": true, "timeout": 15 }
    ],
    "preToolUse": [
      { "command": "python3 .helm/bin/helm_guard.py tool", "failClosed": true, "timeout": 30 }
    ],
    "beforeReadFile": [
      { "command": "python3 .helm/bin/helm_guard.py read", "failClosed": true, "timeout": 10 }
    ],
    "subagentStart": [
      { "command": "python3 .helm/bin/helm_guard.py subagent", "failClosed": true, "timeout": 10 }
    ],
    "afterFileEdit": [
      { "command": "python3 .helm/bin/helm_guard.py postedit", "timeout": 30 }
    ]
  }
}
