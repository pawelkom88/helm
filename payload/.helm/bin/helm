except (ImportError, OSError):
    import importlib.machinery
    import importlib.util
    _p = Path(__file__).resolve().parent
    for _mod_name in ("helm_lib", "helm_guard"):
        if _mod_name not in sys.modules:
            _loader = importlib.machinery.SourceFileLoader(_mod_name, str(_p / f"{_mod_name}.py"))
            _spec = importlib.util.spec_from_loader(_mod_name, _loader)
            _m = importlib.util.module_from_spec(_spec)
            sys.modules[_mod_name] = _m
            _loader.exec_module(_m)
    import helm_guard as G  # noqa: E402
    import helm_lib as L  # noqa: E402

